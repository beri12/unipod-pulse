{
  "name": "unipods-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "UniPods Pulse \u2014 your community. One intelligent memory.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @unipods/api test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "rag:eval": "tsx scripts/rag-eval.ts"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.10.13",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@unipods/ai": "workspace:*",
    "@unipods/config": "workspace:*",
    "@unipods/database": "workspace:*",
    "@unipods/ingest": "workspace:*",
    "@unipods/types": "workspace:*"
  }
}
