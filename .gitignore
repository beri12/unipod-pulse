# logs
*.log
npm-debug.log*
pnpm-debug.log*
/logs/

# test
coverage/
.nyc_output/
test-results/
playwright-report/

# redis dump written into the working directory by a local redis-server
dump.rdb

# local dev uploads and scratch, anchored to the repository root so that a
# source directory named `storage` is not silently excluded
/storage/
/uploads/
/tmp/
# runtime uploads written next to an app when LOCAL_STORAGE_DIR is relative
apps/*/storage/
apps/*/uploads/

# prisma generated client
packages/database/generated/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
