# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=RecallAI
APP_PORT=8000
LOG_LEVEL=INFO
# Comma-separated; empty disables CORS entirely.
CORS_ORIGINS=

# ─── Storage ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://recallai:recallai@postgres:5432/recallai
REDIS_URL=redis://redis:6379/0
STORAGE_PROVIDER=local
STORAGE_PATH=/data/uploads

# ─── WhatsApp Cloud API ──────────────────────────────────────────────────────
# From developers.facebook.com -> your app -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; type the SAME value into Meta's callback form.
WHATSAPP_VERIFY_TOKEN=change-me
# App secret. Set it: without it, inbound webhooks are not authenticated.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ─── Answering ───────────────────────────────────────────────────────────────
# ollama | openai | fake
# "fake" answers by quoting retrieved context — it needs nothing running, and
# is what the tests and the offline demo use. Not for production.
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Embeddings ──────────────────────────────────────────────────────────────
# ollama | openai | fake
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=nomic-embed-text
# MUST match the model's real width. Changing it needs a new migration and a
# re-embed of every chunk (nomic-embed-text=768, text-embedding-3-small=1536).
EMBEDDING_DIMENSIONS=768

# ─── Transcription ───────────────────────────────────────────────────────────
# whisper_local | openai | fake
# whisper_local also needs: pip install faster-whisper
TRANSCRIPTION_PROVIDER=fake
WHISPER_MODEL=base

# ─── Retrieval ───────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
# Never enable in production: it exposes raw chunks.
ENABLE_DEBUG_ENDPOINTS=false
