# ─── WhatsApp Cloud API (official, 1-to-1 chats only) ────────────────────────
# From developers.facebook.com → your app → WhatsApp → API Setup.
# The temporary token expires after 24h; create a System User token for real use.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any random string you invent. Type the SAME value into the Meta dashboard
# when you save the callback URL.
WHATSAPP_VERIFY_TOKEN=change-me

# App Secret, from Meta → App settings → Basic. Optional but recommended:
# when set, webhook payloads that are not signed by Meta are rejected.
WHATSAPP_APP_SECRET=

# Graph API version to call.
WHATSAPP_API_VERSION=v21.0

# ─── Group bot (unofficial, whatsapp-web.js) ────────────────────────────────
# Reads and writes in WhatsApp GROUPS, which the official API cannot do.
# Logs in as a linked device of a normal account by QR scan.
# Against WhatsApp's Terms of Service — use a dedicated SIM, never a personal one.
WHATSAPP_GROUP_BOT_ENABLED=false

# Where the login session is stored. Delete it to force a new QR scan.
WHATSAPP_SESSION_PATH=./wa-session

# Comma-separated group JIDs (e.g. 120363...@g.us). Empty = every group.
# Use !whoami in a group to find its JID in GET /whatsapp/messages.
WHATSAPP_ALLOWED_GROUPS=

# Pause before replying in a group, in milliseconds.
WHATSAPP_REPLY_DELAY_MS=1200

# Chromium binary for WhatsApp Web. Empty lets Puppeteer pick its own.
# The Docker image sets this to /usr/bin/chromium already.
WHATSAPP_CHROME_PATH=

# ─── Telegram (official, groups fully supported) ────────────────────────────
# Token from @BotFather on Telegram. Empty = Telegram switched off.
TELEGRAM_BOT_TOKEN=

# polling = the bot asks Telegram for messages. No public URL needed, works on
#           a laptop or behind a firewall. Best for development.
# webhook = Telegram POSTs to you. Needs a public HTTPS URL. Best for servers.
TELEGRAM_MODE=polling

# Only used in webhook mode: a random string you also pass to setWebhook.
# Telegram echoes it back, which is what stops anyone else posting to your URL.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated chat ids. Empty = every chat the bot is added to.
# Group ids are negative, e.g. -1001234567890.
TELEGRAM_ALLOWED_CHATS=

# ─── Knowledge base (answers from chats, calls and documents) ───────────────
# Claude reads the community's knowledge and answers questions from it.
# Empty = the bot still learns and imports, but does not answer questions.
ANTHROPIC_API_KEY=

# Where knowledge, the open-question backlog and the message archive are kept.
KNOWLEDGE_DATA_DIR=./data

# Learn automatically when a group admin replies to a member's question.
KNOWLEDGE_AUTO_LEARN=true

# How well the sources must answer the question before the bot replies, 0 to 1.
# Below this it says it could not find a confirmed answer and records the gap.
KNOWLEDGE_MIN_CONFIDENCE=0.7

# Required to POST call transcripts and notes to /knowledge/documents.
# Leave empty only on a machine nobody else can reach.
KNOWLEDGE_INGEST_TOKEN=

# Model and effort used for answering (low | medium | high).
KNOWLEDGE_MODEL=claude-opus-5
KNOWLEDGE_EFFORT=low

# Retrieval sizes: entries read in full per answer, and summaries considered.
KNOWLEDGE_MAX_READ=8
KNOWLEDGE_MAX_CANDIDATES=400

# How transcripts are split, in characters.
KNOWLEDGE_CHUNK_SIZE=1400
KNOWLEDGE_CHUNK_OVERLAP=200

# Messages kept per chat for "what did I miss".
KNOWLEDGE_ARCHIVE_LIMIT=500

# In a private chat, answer from every group's knowledge. Leave on for one
# community; turn off when one bot serves several that must stay separate.
KNOWLEDGE_PRIVATE_SEES_EVERYTHING=true

# ─── Voice notes and call recordings ────────────────────────────────────────
# Used ONLY to turn speech into text — Claude has no audio endpoint.
# Empty = the bot ignores voice messages.
OPENAI_API_KEY=

# gpt-4o-transcribe handles French, Arabic and Darija better than whisper-1.
# gpt-4o-transcribe-diarize also labels who spoke, which suits call recordings.
VOICE_MODEL=gpt-4o-transcribe

# Audio at least this long, sent by a group admin, is imported as a recording
# of a call instead of being answered as a question.
VOICE_IMPORT_FROM_SECONDS=120

# Refuse anything larger, in MB (the transcription API's own limit is 25).
VOICE_MAX_SIZE_MB=25

# ─── Shared by every channel ────────────────────────────────────────────────
# Character that marks a command, e.g. "!help".
# In Telegram "/help" also works and is converted to this automatically.
BOT_COMMAND_PREFIX=!

PORT=3000

# ─── Optional: hosted telemetry (https://observe.nestjs.com) ────────────────
# Off unless BOTH are set. Leave empty: with placeholder credentials the agent
# retries against a 401 forever and fills the logs.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=api
