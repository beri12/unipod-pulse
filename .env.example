# ─── WhatsApp Cloud API (official, 1-to-1 chats only) ────────────────────────
# From developers.facebook.com → your app → WhatsApp → API Setup.
# The temporary token expires after 24h; create a System User token for real use.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any random string you invent. Type the SAME value into the Meta dashboard
# when you save the callback URL.
WHATSAPP_VERIFY_TOKEN=change-me

# App Secret, from Meta → App settings → Basic. Optional but recommended:
# when set, webhook payloads that are not signed by Meta are rejected.
WHATSAPP_APP_SECRET=

# Graph API version to call.
WHATSAPP_API_VERSION=v21.0

# ─── Group bot (unofficial, Baileys) ────────────────────────────────────────
# Reads and writes in WhatsApp GROUPS, which the official API cannot do.
# Logs in as a linked device of a normal account by QR scan.
# Against WhatsApp's Terms of Service — use a dedicated SIM, never a personal one.
WHATSAPP_GROUP_BOT_ENABLED=false

# Where the login session is stored. Delete it to force a new QR scan.
WHATSAPP_SESSION_PATH=./wa-session

# Comma-separated group JIDs (e.g. 120363...@g.us). Empty = every group.
# Use !whoami in a group to find its JID in GET /whatsapp/messages.
WHATSAPP_ALLOWED_GROUPS=

# Pause before replying in a group, in milliseconds.
WHATSAPP_REPLY_DELAY_MS=1200

# ─── Telegram (official, groups fully supported) ────────────────────────────
# Token from @BotFather on Telegram. Empty = Telegram switched off.
TELEGRAM_BOT_TOKEN=

# polling = the bot asks Telegram for messages. No public URL needed, works on
#           a laptop or behind a firewall. Best for development.
# webhook = Telegram POSTs to you. Needs a public HTTPS URL. Best for servers.
TELEGRAM_MODE=polling

# Only used in webhook mode: a random string you also pass to setWebhook.
# Telegram echoes it back, which is what stops anyone else posting to your URL.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated chat ids. Empty = every chat the bot is added to.
# Group ids are negative, e.g. -1001234567890.
TELEGRAM_ALLOWED_CHATS=

# ─── Shared by every channel ────────────────────────────────────────────────
# Character that marks a command, e.g. "!help".
# In Telegram "/help" also works and is converted to this automatically.
BOT_COMMAND_PREFIX=!

PORT=3000
