# ---------------------------------------------------------------------------
# UniPods Pulse — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Database (PostgreSQL + pgvector) --------------------------------------
# Any PostgreSQL 14+ with the pgvector extension AVAILABLE ON THE SERVER. The
# extension cannot be installed by the migration — `CREATE EXTENSION` only
# enables what is already on the host — so a stock local PostgreSQL will fail
# the first migration until pgvector is installed into it.
#
# Two setups that need no compiling:
#   Docker  — `pnpm db:up` runs pgvector/pgvector:pg16 with it built in.
#   Supabase — enable `vector` under Database -> Extensions. See docs/supabase.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unipods?schema=public
# Direct (non-pooled) connection used by Prisma Migrate. Usually the same URL
# unless you run PgBouncer / Supabase's pooler / Prisma Accelerate in front of
# Postgres — migrations need a real session, so point this at the direct port.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unipods?schema=public
# Percent-encode reserved characters in the password: `@` is `%40`, `#` is
# `%23`, `/` is `%2F`. An unencoded `@` silently reinterprets the host.

# Port the Docker Postgres publishes. Change it if something already holds 5432
# (a native PostgreSQL install, for instance) and update the URLs above to match.
POSTGRES_PORT=5432

# --- Redis (BullMQ queues) --------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- AI provider ------------------------------------------------------------
# `openai` talks to any OpenAI-compatible endpoint (OpenAI, Azure, Groq,
# Together, vLLM, Ollama...). `local` is a deterministic offline provider used
# for development, CI and tests — it never leaves the machine and never
# invents facts (see docs/ai-providers.md).
AI_PROVIDER=openai
OPENAI_API_KEY=
# Override for OpenAI-compatible gateways, e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
TRANSCRIPTION_MODEL=whisper-1

# --- Object storage ---------------------------------------------------------
# `s3` (AWS S3 / Cloudflare R2 / DigitalOcean Spaces / MinIO) or `local`.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# (relative paths are resolved from the monorepo root, so the API and worker agree)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Required for MinIO and some S3-compatible providers.
S3_FORCE_PATH_STYLE=false

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-in-production-at-least-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# --- HTTP -------------------------------------------------------------------
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
MAX_FILE_SIZE=104857600

# Rate limiting (requests per TTL window, in seconds)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- RAG tuning -------------------------------------------------------------
RAG_TOP_K=8
RAG_MIN_SCORE=0.12
RAG_WEIGHT_SEMANTIC=0.6
RAG_WEIGHT_KEYWORD=0.25
RAG_WEIGHT_RECENCY=0.1
RAG_WEIGHT_SOURCE=0.05
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

# --- Demo mode --------------------------------------------------------------
# When true the API and UI clearly label all content as synthetic demo data.
DEMO_MODE=false

# --- Frontend (public — never put secrets here) -----------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=false

# --- Chat platform bots -----------------------------------------------------
# All optional: with none of these set, the API behaves exactly as before.
#
# Telegram: create the bot with @BotFather, then `/setprivacy` -> Disable, or it
# will only ever receive messages beginning with `/`. See n8n/README.md.
TELEGRAM_BOT_TOKEN=
# Restrict the bot to specific group chat ids (comma separated). Empty = every
# group it is added to.
TELEGRAM_ALLOWED_CHATS=
# Shared secret for POST /api/ingest/*, the endpoints n8n posts to. Generate
# with: openssl rand -base64 48
# Leave empty and those routes refuse every request rather than defaulting open.
BOT_INGEST_SECRET=
