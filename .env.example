# ---------------------------------------------------------------------------
# UniPods Pulse — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Database (PostgreSQL + pgvector) --------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unipods?schema=public
# Direct (non-pooled) connection used by Prisma Migrate. Usually the same URL
# unless you run PgBouncer / Prisma Accelerate in front of Postgres.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unipods?schema=public

# --- Redis (BullMQ queues) --------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- AI provider ------------------------------------------------------------
# `openai` talks to any OpenAI-compatible endpoint (OpenAI, Azure, Groq,
# Together, vLLM, Ollama...). `local` is a deterministic offline provider used
# for development, CI and tests — it never leaves the machine and never
# invents facts (see docs/ai-providers.md).
AI_PROVIDER=openai
OPENAI_API_KEY=
# Override for OpenAI-compatible gateways, e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
TRANSCRIPTION_MODEL=whisper-1

# --- Object storage ---------------------------------------------------------
# `s3` (AWS S3 / Cloudflare R2 / DigitalOcean Spaces / MinIO) or `local`.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Required for MinIO and some S3-compatible providers.
S3_FORCE_PATH_STYLE=false

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-in-production-at-least-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# --- HTTP -------------------------------------------------------------------
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
MAX_FILE_SIZE=104857600

# Rate limiting (requests per TTL window, in seconds)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- RAG tuning -------------------------------------------------------------
RAG_TOP_K=8
RAG_MIN_SCORE=0.18
RAG_WEIGHT_SEMANTIC=0.6
RAG_WEIGHT_KEYWORD=0.25
RAG_WEIGHT_RECENCY=0.1
RAG_WEIGHT_SOURCE=0.05
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

# --- Demo mode --------------------------------------------------------------
# When true the API and UI clearly label all content as synthetic demo data.
DEMO_MODE=false

# --- Frontend (public — never put secrets here) -----------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=false
