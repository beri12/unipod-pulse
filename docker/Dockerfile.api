# syntax=docker/dockerfile:1
#
# UniPods Pulse API.
#
# Built from the monorepo root so workspace packages resolve. The runtime stage
# carries only production dependencies and compiled output.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo

# ---- dependencies -----------------------------------------------------------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/ai/package.json packages/ai/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/ingest/package.json packages/ingest/
COPY packages/types/package.json packages/types/
COPY packages/ui/package.json packages/ui/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# ---- build ------------------------------------------------------------------
FROM deps AS build
COPY tsconfig.base.json turbo.json prisma.config.ts ./
COPY prisma/ prisma/
COPY packages/ packages/
COPY apps/api/ apps/api/
RUN pnpm --filter @unipods/database run generate \
 && pnpm --filter @unipods/config run build \
 && pnpm --filter @unipods/types run build \
 && pnpm --filter @unipods/database run build \
 && pnpm --filter @unipods/ai run build \
 && pnpm --filter @unipods/ingest run build \
 && pnpm --filter @unipods/api run build

# Drop dev dependencies from the tree that gets copied into the runtime image.
RUN pnpm prune --prod

# ---- runtime ----------------------------------------------------------------
FROM base AS runtime
ENV NODE_ENV=production
# Run unprivileged; the image ships with a `node` user.
USER node
WORKDIR /repo

COPY --from=build --chown=node:node /repo/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/package.json ./package.json
COPY --from=build --chown=node:node /repo/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build --chown=node:node /repo/prisma ./prisma
COPY --from=build --chown=node:node /repo/prisma.config.ts ./prisma.config.ts
COPY --from=build --chown=node:node /repo/packages ./packages
COPY --from=build --chown=node:node /repo/apps/api/dist ./apps/api/dist
COPY --from=build --chown=node:node /repo/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=node:node /repo/apps/api/node_modules ./apps/api/node_modules

EXPOSE 3001
# The API's own health endpoint is the source of truth for readiness.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /repo/apps/api
CMD ["node", "dist/main.js"]
